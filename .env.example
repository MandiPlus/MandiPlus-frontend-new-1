NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Customer website push notifications. The public key must match the backend VAPID key.
NEXT_PUBLIC_WEB_PUSH_ENABLED=false
NEXT_PUBLIC_WEB_PUSH_VAPID_KEY=
NEXT_PUBLIC_WEB_PUSH_CANARY_MOBILES=9022353647
# Allows the push service worker on localhost without enabling its caches.
NEXT_PUBLIC_ENABLE_WEB_PUSH_DEV=false
